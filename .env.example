# Mẫu biến môi trường — KHÔNG đặt key thật vào file này (file .env thật bị .gitignore chặn).
# Chỉ endpoint và API key nằm ở đây; TÊN MODEL khai báo trong src/agent_system.py (MODEL_NAME)
# và metadata.json theo đúng yêu cầu đề bài.

# OpenRouter (mặc định) — model nvidia/nemotron-nano-9b-v2:free
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1

# Chạy local bằng Ollama thì dùng thay cho hai dòng trên:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
